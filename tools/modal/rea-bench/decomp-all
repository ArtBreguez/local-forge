#!/usr/bin/env python3
"""decomp-all <binary> [max_bytes]: pseudocode of every non-trivial function up to max_bytes (default 400), smallest first,
each under a header with its address. One command instead of one `decomp` per function: a small model's step budget goes to
reading, not to listing."""
import subprocess
import sys

path = sys.argv[1]
limit = int(sys.argv[2]) if len(sys.argv) > 2 else 400
for line in subprocess.run(["funcs", path], capture_output=True, text=True).stdout.splitlines():
    parts = line.split()
    if len(parts) < 2 or not parts[1].isdigit() or int(parts[1]) > limit:
        continue
    code = subprocess.run(["decomp", path, parts[0]], capture_output=True, text=True).stdout.strip()
    if code:
        print(f"=== {parts[0]} ({parts[1]} bytes)\n{code}\n")
